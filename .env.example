# ==============================================================================
# VendorIQ - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure your local settings.
# NEVER commit the .env file to version control.
# ==============================================================================

# Application Mode: 'OFFLINE' (default) or 'ONLINE'
APP_MODE=OFFLINE

# Google Gemini API Key (Required for ONLINE mode LLM features)
GEMINI_API_KEY=your_gemini_api_key_here

# Crustdata API Key (Required for ONLINE mode vendor enrichment)
CRUSTDATA_API_KEY=your_crustdata_api_key_here

# Database Configuration (Default: vendoriq.sqlite)
# For development, browser QA, or testing isolation, set VENDORIQ_DB_PATH
# VENDORIQ_DB_PATH=data/dev_vendoriq.sqlite
DATABASE_PATH=vendoriq.sqlite
